# ============================================
# MAESTRO TRADING BOT — Environment Variables
# Copy this file to .env and fill in your values
# ============================================

# REQUIRED — Telegram bot token from @BotFather
BOT_TOKEN=8733666341:AAHq44coBmjVoUhqIvOakzifwbwJb7jvP6I

# REQUIRED — Solana RPC endpoint
# Free: https://api.mainnet-beta.solana.com
# Recommended (faster): QuickNode, Helius, or Alchemy
SOLANA_RPC=https://api.mainnet-beta.solana.com

# REQUIRED — Your Telegram numeric user ID(s)
# Get your ID by messaging @userinfobot on Telegram
# Multiple admins: comma-separated, max 2
ADMIN_CHAT_IDS=

# REQUIRED — Your Solana wallet address to receive commission fees
# Must be a normal Solana address (not an ATA/token account)
COMMISSION_WALLET=HswwkhjcueakMwe6Mzap455MDYnnhHrSHjdFwRWfTAdu

# Commission percentage taken per trade (default: 2.5)
# 2.5 = 2.5% of each buy/sell goes to COMMISSION_WALLET as SOL
COMMISSION_PERCENTAGE=4%

# Jupiter V6 API endpoint (default shown, change if using a paid tier)
JUPITER_API=https://lite-api.jup.ag/swap/v1

# OPTIONAL — Redis URL for persistent storage across restarts
# Without this, all sessions reset on bot restart
# Railway: add Redis plugin and copy its REDIS_URL variable
# Format: redis://default:password@host:port
REDIS_URL=redis://default:yourpassword@your-redis-host:6379
